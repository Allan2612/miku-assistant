{
  "manifest_version": 3,
  "name": "Miku Assistant - Opera",
  "description": "Lets Miku see and manage your Opera tabs (local only: talks to ws://127.0.0.1:8765).",
  "version": "1.2.1",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["tabs", "alarms", "scripting"],
  "host_permissions": [
    "*://*.google.com/*",
    "*://*.google.co.cr/*",
    "*://*.youtube.com/*",
    "*://duckduckgo.com/*",
    "*://*.bing.com/*"
  ],
  "background": { "service_worker": "background.js" }
}
