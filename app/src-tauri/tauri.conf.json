{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Miku Assistant",
  "mainBinaryName": "miku",
  "version": "0.1.0",
  "identifier": "com.miku.assistant",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Miku Assistant",
        "width": 420,
        "height": 620,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "panel",
        "title": "Miku Assistant",
        "url": "panel.html",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "visible": false,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:8765 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Miku, tu asistente de voz para Windows",
    "resources": {
      "../../core/*.py": "core/",
      "../../core/requirements.lock": "core/requirements.lock",
      "../../core/tools/*.py": "core/tools/",
      "../../core/infer_pack/*.py": "core/infer_pack/",
      "../../core/infer_pack/LICENSE": "core/infer_pack/LICENSE",
      "../../models/rvc/miku_diva.pth": "models/rvc/miku_diva.pth",
      "../../models/rvc/miku_diva.index": "models/rvc/miku_diva.index",
      "../../models/rvc/rmvpe.pt": "models/rvc/rmvpe.pt",
      "../../models/wakeword/hey_miku.onnx": "models/wakeword/hey_miku.onnx",
      "../../docs/funciones.md": "docs/funciones.md",
      "../../config.yaml": "config.default.yaml",
      "../../installer/setup.ps1": "installer/setup.ps1",
      "../../browser-extension/*": "browser-extension/",
      "../../browser-extension/icons/*": "browser-extension/icons/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "../../installer/hooks.nsh"
      }
    }
  }
}